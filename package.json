{
  "name": "balatro-mod-manager",
  "version": "0.4.1",
  "description": "A mod manager for Balatro - easily install and manage mods for the popular roguelike deckbuilding game",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint -c oxlint.json",
    "lint:fix": "oxlint -c oxlint.json --fix",
    "format": "prettier --write \"src/**/*.{svelte,ts,js,css,html}\"",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-shell": "^2.4.0",
    "@tauri-apps/plugin-window-state": "^2.5.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "1.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.14.5",
    "lucide-svelte": "^1.0.1",
    "marked": "^18.0.14",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-confetti": "^2.3.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.2.5"
}
